@using System.Security.Claims
<!DOCTYPE html>
<html lang="az" data-theme="dark">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>@(ViewData["Title"] ?? "Qurani-Kərim")</title>
<script>document.documentElement.dataset.theme=localStorage.getItem('theme')||'dark'</script>
<link rel="stylesheet" href="~/css/style.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/modal.css" asp-append-version="true">
@RenderSection("Head", false)
</head>
<body data-auth="@(User.Identity?.IsAuthenticated == true ? "1" : "")" data-admin="@(User.IsInRole("Admin") ? "1" : "")">
<header class="header">
  <div class="header__in">
    <a href="/" class="logo"><b>ق</b> Qurani-Kərim</a>

    <nav class="nav">
      <button id="surahBtn" data-i18n="surahs">Surələr</button> <!-- Part 2: modal -->
      <a href="/Home/Wishlist" data-i18n="wishlist">Bəyəndiklərim</a>
      <a href="/Home/Notes" data-i18n="notes">Qeydlərim</a>
      @if (User.IsInRole("Admin")) { <a href="/Home/Admin">Admin</a> }
    </nav>

    <form class="search" role="search" action="/Home/Search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="search" id="q" name="q" data-i18n-ph="search" placeholder="Axtar: 3:2 və ya söz" aria-label="Search">
    </form>

    <div class="tools">
      <select id="lang" class="select" aria-label="Language">
        <option value="az">AZ</option><option value="en">EN</option><option value="ru">RU</option><option value="tr">TR</option>
      </select>
      <button id="themeBtn" class="icon-btn" aria-label="Theme">
        <svg class="i-sun" width="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="i-moon" width="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      @if (User.Identity?.IsAuthenticated == true) {
        <span class="uname">@User.Identity.Name</span>
        <form method="post" action="/Account/Logout" style="display:inline">@Html.AntiForgeryToken()<button class="btn" data-i18n="logout">Çıxış</button></form>
      } else {
        <a href="/Account/Login" class="btn" data-i18n="login">Daxil ol</a>
        <a href="/Account/Register" class="btn btn--solid" data-i18n="register">Qeydiyyat</a>
      }
    </div>
  </div>
</header>

@RenderBody()

<footer class="footer">
  <span class="ar" lang="ar">بِسْمِ اللَّهِ</span>
  <span data-i18n="footer">Qurani-Kərim — oxu, düşün, yadda saxla</span>
</footer>

<dialog id="surahModal" class="modal" aria-labelledby="surahTitle">
  <div class="modal__box">
    <header class="modal__head">
      <h2 id="surahTitle" data-i18n="surahs">Surələr</h2>
      <button class="icon-btn" id="surahClose" aria-label="Close">✕</button>
    </header>
    <input type="search" id="surahFilter" class="modal__filter" data-i18n-ph="filter" placeholder="Surə axtar">
    <ol id="surahList" class="surahs"></ol>
    <p id="surahEmpty" class="modal__empty" data-i18n="noSurah" hidden>Belə surə tapılmadı</p>
  </div>
</dialog>

<script src="~/js/main.js" asp-append-version="true"></script>
<script src="~/js/surahs.js" asp-append-version="true"></script>
@RenderSection("Scripts", false)
</body>
</html>
